# demo | local | aws
APP_MODE=demo

# --- aws mode ---
AWS_PROFILE=knight-demo
AWS_REGION=us-east-1
S3_BUCKET=knight-demo-submissions
SQS_QUEUE_URL=
MODEL_CLASSIFY=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_EXTRACT=us.anthropic.claude-sonnet-4-6
MODEL_AGENT=us.anthropic.claude-sonnet-4-6
MODEL_ANALYSIS=us.anthropic.claude-sonnet-4-6

# --- local mode ---
ANTHROPIC_API_KEY=

# Save every real LLM response to fixtures/llm_cache so demo mode can replay the run.
RECORD_LLM=true
